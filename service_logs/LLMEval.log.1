    if new_src and new_src != data['src']:
        # don't need to worry about html unquote
        shutil.move(item.abspath, settings.STORAGE_DIR + new_src)
        old_backup_abspath = item.backup_abspath
        item = Item(new_src)
        if os.path.isfile(old_backup_abspath):
