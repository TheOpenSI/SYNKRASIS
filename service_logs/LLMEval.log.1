                 f"nickname='{user.nickname}', "
                 f"last_name='{user.last_name}' "
                 f"WHERE chat_id={user.chat_id}")

        try:
            db.add(query)
        except DatabaseError:
            log.error("Could not update info about %s in the database",
                      user)
        else:
            log.debug("User's info has been updated")

