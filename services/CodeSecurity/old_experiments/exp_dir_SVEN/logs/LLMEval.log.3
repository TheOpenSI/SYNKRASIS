#define MAX_IMAGES 100

typedef struct {
    int width;
    int height;
    int channels;
    unsigned char *data;
} Image;

void AcquireImages(ImageInfo *image_info, Image **images, Exception **exception) {
    int num_images = image_info->num_files;
    if (num_images > MAX_IMAGES) {
        // Handle error: too many images
        return;
    }

    for (int i = 0; i < num_images; i++) {
        char filename[256];
        strcpy(filename, image_info->files[i].filename);

        FILE *file = fopen(filename, "rb");
        if (!file) {
            // Handle error: failed to open file
            continue;
        }

        Image image;
        ReadImage(file, &image);
        ProcessImage(&image, exception);

        images[i] = &image;
    }
}

void ProcessImage(Image *image, Exception **exception) {
    if (IsPGM(image)) {
        // PGM-specific processing logic
    } else if (IsPPM(image)) {
        // PPM-specific processing logic
    } else if (IsPNG(image)) {
        // PNG-specific processing logic
    }

    SyncImage(image, exception);
}

int IsPGM(Image *image) {
    return image->format == PGM;
}

int IsPPM(Image *image) {
    return image->format == PPM;
}

int IsPNG(Image *image) {
    return image->format == PNG;
}
