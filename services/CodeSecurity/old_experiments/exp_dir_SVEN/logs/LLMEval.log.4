def get_user(self):
    if not hasattr(self, '_user'):
        query = "SELECT * FROM account_access WHERE access_token = %s"
        result = self.db.get(query, (self.access_token,))
        if result:
            self._user = result
        else:
            self._user = None
        
    return self._user
```

